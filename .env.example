# Copie ce fichier en ".env" et remplis les valeurs.

# Port local du serveur
PORT=8787

# Mot de passe du site (FORTEMENT recommandé si le site est accessible sur Internet)
APP_TOKEN=

# Ton courriel (exigé par Apple pour les notifications push). Garde le "mailto:"
VAPID_SUB=mailto:ton.courriel@gmail.com

# Rappel avant chaque annonce (minutes)
REMINDER_MINUTES=15

# Heure (Est) de l'analyse du dimanche
WEEKLY_HOUR=17

# OPTIONNEL — analyse du dimanche rédigée par IA (1 appel par semaine, quelques cents)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OPTIONNEL — clé Trading Economics (payante) pour ajouter le "TE Forecast"
TE_API_KEY=
