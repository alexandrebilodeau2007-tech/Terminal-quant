# Copie ce fichier sous le nom "secrets.toml" (même dossier) et remplis-le.
# NE JAMAIS publier secrets.toml sur GitHub (il est dans .gitignore).

# Clé gratuite : https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY = "colle_ta_cle_ici"

# Exigé par la SEC : ton nom et ton courriel (aucune inscription nécessaire).
SEC_USER_AGENT = "Prénom Nom ton.courriel@exemple.com"
